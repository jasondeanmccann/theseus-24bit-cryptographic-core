def get_rc1_forward(state):
    STATE_MASK = 0xFFFFFF
    MULTIPLIER = 16777213
    ADDITIVE_OFFSET = 70
    mixed_state = (state ^ 0x5A5A5A) & STATE_MASK
    dispersed = (mixed_state * MULTIPLIER + ADDITIVE_OFFSET) & STATE_MASK
    return dispersed

