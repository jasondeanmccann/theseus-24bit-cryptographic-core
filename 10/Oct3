def _sub_bytes(state, sbox_table):
    b1 = (state >> 16) & 0xFF
    b2 = (state >> 8) & 0xFF
    b3 = state & 0xFF
    return (sbox_table[b1] << 16) | (sbox_table[b2] << 8) | sbox_table[b3]

def _permute_bits(state):
    output = 0
    for i in range(24):
        if (state & (1 << i)):
            target_pos = (i * 7) % 24
            output |= (1 << target_pos)
    return output

def get_rc2_forward(state):
    ROUNDS = 4
    ROUND_KEYS = [((r * 11) % 70) * 0x010101 for r in range(1, ROUNDS + 1)]
    current = state
    for r in range(ROUNDS):
        current ^= ROUND_KEYS[r]
        current = _sub_bytes(current, SBOX)
        if r < ROUNDS - 1:
            current = _permute_bits(current)
    return current & 0xFFFFFF

def get_rc3_forward(state, master_key=0x123456):
    ROUNDS = 4
    ROUND_KEYS = [((r * 11) % 70) * 0x010101 for r in range(1, ROUNDS + 1)]
    k1 = (master_key >> 16) & 0xFF
    k2 = (master_key >> 8) & 0xFF
    k3 = master_key & 0xFF
    
    current = state
    for r in range(ROUNDS):
        current ^= ROUND_KEYS[r]
        # dynamic sub bytes
        b1 = (current >> 16) & 0xFF
        b2 = (current >> 8) & 0xFF
        b3 = current & 0xFF
        s1 = SBOX[(b1 + k1) % 256]
        s2 = SBOX[(b2 + k2) % 256]
        s3 = SBOX[(b3 + k3) % 256]
        current = (s1 << 16) | (s2 << 8) | s3
        if r < ROUNDS - 1:
            current = _permute_bits(current)
    return current & 0xFFFFFF

def get_cbc_encrypt(vector, iv=0xA5A5A5):
    previous = iv
    ciphertexts = []
    for val in vector:
        mixed = val ^ previous
        cipher = get_rc3_forward(mixed)
        ciphertexts.append(cipher)
        previous = cipher
    return ciphertexts

