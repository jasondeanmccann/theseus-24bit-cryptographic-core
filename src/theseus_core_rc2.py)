        # Build the exact mathematical Inverse S-Box dynamically
        self.INV_SBOX = [0] * 256
        for idx, val in enumerate(self.SBOX):
            self.INV_SBOX[val] = idx
            
        # Derive structural round keys using a Modulo-70 offset pattern
        self.ROUND_KEYS = [((r * 11) % 70) * 0x010101 for r in range(1, self.ROUNDS + 1)]

    def _sub_bytes(self, state: int, sbox_table: list) -> int:
        """Splits the 24-bit state into 3 bytes and targets substitution."""
        b1 = (state >> 16) & 0xFF
        b2 = (state >> 8) & 0xFF
        b3 = state & 0xFF
        return (sbox_table[b1] << 16) | (sbox_table[b2] << 8) | sbox_table[b3]

    def _permute_bits(self, state: int) -> int:
        """Interleaves active bits across the 24-bit boundary boundary (Diffusion)."""
        output = 0
        for i in range(24):
            if (state & (1 << i)):
                target_pos = (i * 7) % 24
                output |= (1 << target_pos)
        return output

    def _inverse_permute_bits(self, state: int) -> int:
        """Reverses the bit-shuffle layer precisely."""
        output = 0
        for i in range(24):
            target_pos = (i * 7) % 24
            if (state & (1 << target_pos)):
                output |= (1 << i)
        return output

    def forward(self, state: int) -> int:
        """Executes 4 rounds of progressive SPN encryption transitions."""
        if not (0 <= state <= self.STATE_MASK):
            raise ValueError(f"State {state} is out of bounds.")
            
        current = state
        for r in range(self.ROUNDS):
            current ^= self.ROUND_KEYS[r]
            current = self._sub_bytes(current, self.SBOX)
            if r < self.ROUNDS - 1:
                current = self._permute_bits(current)
                
        return current & self.STATE_MASK

    def inverse(self, permuted_state: int) -> int:
        """Reverses structural operations to recover the original input state."""
        if not (0 <= permuted_state <= self.STATE_MASK):
            raise ValueError(f"State {permuted_state} is out of bounds.")
            
        current = permuted_state
        for r in reversed(range(self.ROUNDS)):
            if r < self.ROUNDS - 1:
                current = self._inverse_permute_bits(current)
            current = self._sub_bytes(current, self.INV_SBOX)
            current ^= self.ROUND_KEYS[r]
            
        return current & self.STATE_MASK


